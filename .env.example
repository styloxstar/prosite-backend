# Copy to .env and fill in. Never commit real values.

PORT=5000
MONGO_URI=mongodb://localhost:27017/prosite

# REQUIRED, at least 32 characters. The API refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated frontend origins allowed by CORS. The first one is used in e-mail links.
CLIENT_URL=http://localhost:5173

UPI_PAYEE_ID=
UPI_PAYEE_NAME=

# Gmail address + Google App Password used to send activation / receipt e-mails.
EMAIL_USER=
EMAIL_PASS=

# Optional: create the first admin account on an empty database (password >= 12 characters).
# Existing accounts are never modified. Remove these after the first successful start.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=

# Local development only: set to "false" to skip creating the demo "deepak" workspace.
# (It is never created when NODE_ENV=production or on Vercel.)
SEED_DEV_USER=true
